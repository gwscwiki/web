---
/**
 * Light-mode switch replacing Starlight's Auto/Dark/Light select (dark is the default).
 * A toggle button: pressed = light. Stores the choice under Starlight's `starlight-theme` key.
 */
import { langFromLocals } from '../../lib/ui';
const label = langFromLocals(Astro.locals) === 'en' ? 'Light mode' : 'Mode clair';
---

<gw-theme-toggle>
  <button type="button" aria-pressed="false" title={label}>
    <span class="gw-visually-hidden">{label}</span>
    <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" /></svg>
    <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.2" /><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M4.9 19.1 7 17M17 7l2.1-2.1" /></svg>
  </button>
</gw-theme-toggle>

<script is:inline>
  StarlightThemeProvider.updatePickers();
</script>

<script>
  class GwThemeToggle extends HTMLElement {
    connectedCallback() {
      this.querySelector('button')?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('starlight-theme', next);
        StarlightThemeProvider.updatePickers(next);
      });
    }
  }
  customElements.define('gw-theme-toggle', GwThemeToggle);
</script>

<style>
  button {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 1px solid var(--gw-border);
    border-radius: var(--gw-radius-pill);
    background: var(--gw-surface-2);
    color: var(--gw-text-muted);
    cursor: pointer;
    transition: color var(--gw-duration-fast) var(--gw-ease), border-color var(--gw-duration-fast) var(--gw-ease);
  }
  button:hover { color: var(--gw-accent); border-color: var(--gw-border-accent); }
  svg { grid-area: 1 / 1; width: 1.1rem; height: 1.1rem; }
  .moon { fill: currentColor; }
  .sun { fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; }
  .sun circle { fill: currentColor; stroke: none; }
  /* Show what you'll switch to: moon while light, sun while dark. */
  button[aria-pressed='false'] .moon,
  button[aria-pressed='true'] .sun { display: none; }
</style>
