---
/**
 * Splash hero (home page): sigil → kicker → display title → tagline → divider → "choose your path",
 * over a line-art skyline (src/assets/ornaments/skyline.svg, tinted by tokens).
 * Reads Starlight's `hero` frontmatter (title, tagline, actions) so content stays plain MDX.
 */
import sigil from '../../assets/ornaments/sigil.svg';
import { langFromLocals, t } from '../../lib/ui';
import { Button, Kicker } from '../ui';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
const _ = t(langFromLocals(Astro.locals));
---

<div class="gw-hero">
  <img class="gw-hero__sigil" src={sigil.src} alt="" width="72" height="72" />
  <Kicker>{_('kicker')}</Kicker>
  <h1 id="_top" class="gw-hero__title" set:html={title} />
  {tagline && <p class="gw-hero__tagline" set:html={tagline} />}
  {
    actions.length > 0 && (
      <div class="gw-hero__actions">
        {actions.map(({ text, link, variant }) => (
          <Button href={link} variant={variant === 'primary' ? 'primary' : 'ghost'} arrow>{text}</Button>
        ))}
      </div>
    )
  }
  <div class="gw-hero__skyline" aria-hidden="true"></div>
  <div class="gw-divider gw-hero__divider" aria-hidden="true"><span></span></div>
  <Kicker class="gw-hero__cue">{_('choosePath')}</Kicker>
</div>

<style>
  .gw-hero {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gw-space-4);
    padding-block: var(--gw-space-6) var(--gw-space-5);
    text-align: center;
    isolation: isolate;
  }
  .gw-hero__skyline {
    width: 100%;
    height: 7rem;
    margin-bottom: calc(-1 * var(--gw-space-6));
    background-color: var(--gw-ornament);
    opacity: 0.55;
    -webkit-mask: url(../../assets/ornaments/skyline.svg) bottom center / 100% 100% no-repeat;
    mask: url(../../assets/ornaments/skyline.svg) bottom center / 100% 100% no-repeat;
  }
  .gw-hero__sigil { width: 4.5rem; height: 4.5rem; }
  .gw-hero__title {
    margin: 0;
    font-family: var(--gw-font-display);
    font-weight: var(--gw-weight-bold);
    font-size: clamp(var(--gw-text-3xl), 6vw, 4rem);
    line-height: 1.05;
    letter-spacing: var(--gw-tracking-wide);
    color: var(--gw-text-strong);
  }
  .gw-hero__tagline { max-width: 52ch; margin: 0; font-size: var(--gw-text-lg); color: var(--gw-text); }
  .gw-hero__actions { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--gw-space-3); }
  .gw-hero__divider { width: min(28rem, 100%); margin-block: var(--gw-space-2) 0; color: var(--gw-ornament-accent); }
</style>
