---
/**
 * Generated part of an entity page rendered *after* the prose (MarkdownContent override).
 * Counterpart of EntityPanel, which renders above it. Reads shared data from the French twin.
 * Duty: the Role carrying it in each Strategy, each row expanding onto its build and kit; the Gear
 * sets and Consumables bound to it; its Region, linking back to the Zone's map. Any entity: the credit
 * for its sources, last.
 */
import { List, Panel } from '../ui';
import Composition from './Composition.astro';
import Needs from './Needs.astro';
import GearNeeds from '../gear/GearNeeds.astro';
import { gearNeedsForDuty, getShared, needsFor, rolesByDuty, titleOf, tr, urlOf, zoneOf, type Entity } from '../../lib/kb';
import { compRow } from '../../lib/composition';
import { langFromLocals, t } from '../../lib/ui';

const lang = langFromLocals(Astro.locals);
const _ = t(lang);
const route = Astro.locals.starlightRoute;
const shared = route.entry ? await getShared(route.entry.id) : undefined;
const kind = shared?.data.kind;
const L = async (id: string) => ({ href: urlOf(id, lang), text: await titleOf(id, lang) });
const fmtDate = (d: Date) => d.toLocaleDateString(lang === 'fr' ? 'fr-FR' : 'en-GB', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });

const sources: { title: string; url: string; site?: string; author?: string; edited?: Date }[] =
  (shared?.data as { sources?: [] } | undefined)?.sources ?? [];

let p: Record<string, any> = {};

if (kind === 'duty') {
  const d = shared as unknown as Entity<'duty'>;
  const zone = await zoneOf(d.id);
  p.zone = zone && (await L(zone.id));
  const region = zone?.data.regions.find((r) => r.id === d.data.region);
  p.region = region && tr(region.name, lang)!.text;
  const bySetup = await rolesByDuty(d.id);
  p.builds = [];
  for (const { strategy, rows } of bySetup) for (const r of rows) p.builds.push(await compRow(r, lang, strategy));
  p.current = urlOf(d.id, lang);
  p.gear = (await gearNeedsForDuty(d.id)).map((x) => ({ ...x.need, holder: x.holder.id }));
  p.needs = await needsFor([d.id]);
}
---

{
  (kind === 'duty' || sources.length > 0) && (
    <div class="gw-entity-foot not-content">
      {kind === 'duty' && (
        <Panel kicker={_('duty')} title={_('buildsByStrategy')}>
          {p.builds.length > 0 ? (
            <>
              <p class="gw-muted gw-entity-foot__hint">{_('buildsByStrategyHint')}</p>
              <Composition rows={p.builds} current={p.current} />
            </>
          ) : (
            <p class="gw-muted">{_('inNoStrategy')}</p>
          )}
        </Panel>
      )}
      {kind === 'duty' && p.gear.length > 0 && <Panel title={_('gearForDuty')}><GearNeeds needs={p.gear} hideDuties /></Panel>}
      {kind === 'duty' && p.needs.length > 0 && <Panel title={_('consumables')}><Needs needs={p.needs} /></Panel>}
      {kind === 'duty' && p.zone && (
        <p class="gw-entity-foot__region">
          <span class="gw-muted">{_('region')}{lang === 'fr' ? ' :' : ':'}</span> <strong>{p.region ?? '—'}</strong>
          · <a href={`${p.zone.href}#map`}>{_('seeMap')} →</a>
        </p>
      )}
      {sources.length > 0 && (
        <Panel tone="info" kicker={_('source')}>
          <p class="gw-entity-foot__credit">{_('creditIntro')}</p>
          <List tone="info">
            {sources.map((s) => (
              <li>
                <a href={s.url} rel="noopener" target="_blank">{s.title}</a>
                {s.site && <span class="gw-muted"> · {s.site}</span>}
                {s.author && <span> · {_('by')} {s.author}</span>}
                {s.edited && <span class="gw-muted"> · {_('editedOn')} {fmtDate(s.edited)}</span>}
              </li>
            ))}
          </List>
        </Panel>
      )}
    </div>
  )
}

<style>
  .gw-entity-foot { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--gw-space-4); margin-top: var(--gw-space-6); }
  .gw-entity-foot a { color: var(--gw-accent-text); text-decoration: none; }
  .gw-entity-foot a:hover { color: var(--gw-accent-strong); text-decoration: underline; }
  .gw-entity-foot__hint { margin: 0 0 var(--gw-space-3); font-size: var(--gw-text-sm); }
  .gw-entity-foot__region { margin: 0; font-size: var(--gw-text-sm); }
  .gw-entity-foot__credit { margin: 0 0 var(--gw-space-2); }
</style>
