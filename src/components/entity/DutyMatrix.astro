---
/**
 * Who carries a Duty, as a Role × Strategy grid. Strategy names run diagonally across the top;
 * a diamond marks the Role carrying the Duty in that Strategy, a dot a Role that is in the
 * Strategy but on other Duties, an empty cell a Role the Strategy doesn't field.
 */
import { langFromLocals, t } from '../../lib/ui';

interface Link { href: string; text: string }
export type Cell = 'carries' | 'present' | 'absent';
interface Props {
  strategies: (Link & { isDefault: boolean; carried: boolean })[];
  rows: { role: Link; cells: Cell[] }[];
}
const { strategies, rows } = Astro.props;
const _ = t(langFromLocals(Astro.locals));
// Rotated at 45°, a label rises ~0.36em per character; reserve that much header height.
const longest = Math.max(...strategies.map((s) => s.text.length), 4);
const headH = `${(longest * 0.36 + 1).toFixed(2)}em`;
const cellLabel = { carries: _('matrixCarries'), present: _('matrixPresent'), absent: _('matrixAbsent') };
---

<div class="gw-dm" style={`--_head-h: ${headH}`}>
  <table>
    <thead>
      <tr>
        <th scope="col" class="gw-dm__corner"><span>{_('role')}</span></th>
        {
          strategies.map((s) => (
            <th scope="col" class:list={['gw-dm__col', s.isDefault && 'is-default', !s.carried && 'is-idle']}>
              <div>
                <a href={s.href} title={s.isDefault ? `${s.text} (${_('default').toLowerCase()})` : s.text}>{s.text}</a>
              </div>
            </th>
          ))
        }
      </tr>
    </thead>
    <tbody>
      {
        rows.map((r) => (
          <tr>
            <th scope="row"><a href={r.role.href}>{r.role.text}</a></th>
            {r.cells.map((c, i) => (
              <td class:list={[`is-${c}`, strategies[i].isDefault && 'is-default']} title={`${r.role.text} · ${strategies[i].text} : ${cellLabel[c]}`}>
                {c !== 'absent' && <span class="gw-dm__mark" aria-hidden="true" />}
                <span class="gw-visually-hidden">{cellLabel[c]}</span>
              </td>
            ))}
          </tr>
        ))
      }
    </tbody>
  </table>
  <p class="gw-dm__legend">
    <span><span class="gw-dm__mark is-carries" aria-hidden="true" /> {_('matrixCarries')}</span>
    <span><span class="gw-dm__mark is-present" aria-hidden="true" /> {_('matrixPresent')}</span>
  </p>
</div>

<style>
  .gw-dm {
    --_col: 2.25rem;
    overflow-x: auto;
    /* Room for the last label, which leans past the table's right edge. */
    padding-inline-end: var(--_head-h);
  }
  table { border-collapse: collapse; font-size: var(--gw-text-sm); }

  thead th { height: var(--_head-h); padding: 0; vertical-align: bottom; border-bottom: 1px solid var(--gw-divider); }
  .gw-dm__corner > span {
    display: block;
    padding: var(--gw-space-2);
    text-align: start;
    font-family: var(--gw-font-display);
    font-weight: var(--gw-weight-bold);
    font-size: var(--gw-text-3xs);
    letter-spacing: var(--gw-tracking-wider);
    text-transform: uppercase;
    color: var(--gw-text-subtle);
  }
  .gw-dm__col { position: relative; width: var(--_col); min-width: var(--_col); }
  /* Label anchored at the column's bottom centre, then tilted up and to the right. */
  .gw-dm__col > div {
    position: absolute;
    left: 50%;
    bottom: var(--gw-space-2);
    transform-origin: 0 50%;
    transform: rotate(-45deg);
    white-space: nowrap;
    font-size: var(--gw-text-xs);
    font-weight: var(--gw-weight-bold);
    line-height: 1;
  }
  .gw-dm__col a { color: var(--gw-text); }
  .gw-dm__col.is-default a { color: var(--gw-accent-text); }
  .gw-dm__col.is-idle a { color: var(--gw-text-muted); font-weight: normal; }

  tbody th {
    padding: var(--gw-space-1) var(--gw-space-3) var(--gw-space-1) var(--gw-space-2);
    text-align: start;
    white-space: nowrap;
    font-weight: var(--gw-weight-bold);
  }
  tbody tr > * { border-bottom: 1px solid var(--gw-divider); }
  tbody tr:last-child > * { border-bottom: 0; }
  tbody tr:hover > * { background: var(--gw-surface-hover); }
  td { padding: 0; text-align: center; vertical-align: middle; border-inline-start: 1px solid var(--gw-divider); }
  td.is-default { background: color-mix(in srgb, var(--gw-accent-soft) 55%, transparent); }

  a { color: var(--gw-accent-text); text-decoration: none; }
  a:hover { color: var(--gw-accent-strong); text-decoration: underline; }

  .gw-dm__mark { display: inline-block; vertical-align: middle; }
  .is-carries > .gw-dm__mark, .gw-dm__mark.is-carries {
    width: 0.55rem;
    height: 0.55rem;
    background: var(--gw-accent);
    transform: rotate(45deg);
  }
  .is-present > .gw-dm__mark, .gw-dm__mark.is-present {
    width: 0.3rem;
    height: 0.3rem;
    border-radius: 50%;
    background: var(--gw-text-muted);
    opacity: 0.6;
  }

  .gw-dm__legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gw-space-2) var(--gw-space-4);
    margin: var(--gw-space-3) 0 0;
    font-size: var(--gw-text-2xs);
    color: var(--gw-text-muted);
  }
  .gw-dm__legend .gw-dm__mark { margin-inline-end: var(--gw-space-1); }
</style>
