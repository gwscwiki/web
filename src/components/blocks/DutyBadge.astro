---
import { Badge } from '@astrojs/starlight/components';
import { entity, urlOf } from '../../lib/kb';
import { langFromLocals } from '../../lib/ui';

interface Props { duty: string }
const lang = langFromLocals(Astro.locals);
const d = await entity(Astro.props.duty, 'duty');
if (!d) throw new Error(`DutyBadge: no Duty "${Astro.props.duty}"`);
---

<a href={urlOf(d.id, lang)} class="gw-duty"><Badge text={d.data.label} variant="note" /></a>

<style>.gw-duty { text-decoration: none; }</style>
