---
/** Bar block from a raw template code: display only, not a Build (Storage mapping). */
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { decodeBar } from '../../lib/gw/templates';
import { attributeName, PROFESSIONS, professionName } from '../../lib/gw/names';
import { renderDescription } from '../../lib/gw/describe';
import { langFromLocals, t } from '../../lib/ui';

interface Props {
  code: string;
  /** slot index → mark, used by BuildBar to highlight swaps */
  marks?: Record<number, 'swap' | 'filled'>;
}
const { code, marks = {} } = Astro.props;
const lang = langFromLocals(Astro.locals);
const _ = t(lang);
const bar = decodeBar(code);

// Local icons: src/assets/skill-icons/<skill id>.(jpg|png|webp). Missing → placeholder tile.
const icons = import.meta.glob<{ default: ImageMetadata }>('/src/assets/skill-icons/*.{jpg,png,webp}', { eager: true });
const iconFor = (id: number) =>
  Object.entries(icons).find(([p]) => p.replace(/^.*\//, '').replace(/\.\w+$/, '') === String(id))?.[1].default;

const slots = await Promise.all(
  bar.skills.map(async (id, i) => {
    const s = id ? (await getEntry('skills', String(id)))?.data : undefined;
    if (id && !s) throw new Error(`SkillBar: skill ${id} missing from the skills collection (code ${code})`);
    return { i, id, s, icon: id ? iconFor(id) : undefined, mark: marks[i] };
  }),
);
const sec = bar.secondary ? PROFESSIONS[bar.secondary].abbr : '–';
---

<figure class="gw-bar not-content">
  <figcaption>
    <strong title={`${professionName(bar.primary, lang)} / ${professionName(bar.secondary, lang)}`}>
      {PROFESSIONS[bar.primary].abbr}/{sec}
    </strong>
    <span class="gw-attrs">
      {Object.entries(bar.attributes).map(([a, r]) => <span>{attributeName(Number(a), lang)} {r}</span>)}
    </span>
  </figcaption>
  <ol>
    {
      slots.map(({ id, s, icon, mark }) => (
        <li class:list={['gw-slot', mark && `gw-${mark}`, !id && 'gw-empty']} tabindex={id ? 0 : undefined}>
          {s ? (
            <>
              {icon ? (
                <Image src={icon} alt="" width={64} height={64} />
              ) : (
                <span class="gw-icon-ph" aria-hidden="true">{s.name.en.replace(/[^A-Z]/g, '').slice(0, 3)}</span>
              )}
              <span class="gw-name">
                {s.name[lang]}
                {s.nickname && <em> ({s.nickname})</em>}
              </span>
              <span class="gw-tip" role="tooltip">
                <strong>{s.name[lang]}</strong>
                {lang === 'fr' && <small> — {s.name.en}</small>}
                <span class="gw-stats">
                  {s.energy > 0 && <span>{_('energy')} {s.energy}</span>}
                  {s.adrenaline > 0 && <span>Adr. {s.adrenaline}</span>}
                  <span>{_('activation')} {s.activation}s</span>
                  {s.recharge > 0 && <span>{_('recharge')} {s.recharge}s</span>}
                </span>
                <span set:html={renderDescription(s.description[lang])} />
              </span>
            </>
          ) : (
            <span class="gw-icon-ph" aria-hidden="true" />
          )}
        </li>
      ))
    }
  </ol>
  <div class="gw-code">
    <code>{code}</code>
    <button type="button" data-copy={code}>{_('copy')}</button>
  </div>
</figure>

<script>
  document.querySelectorAll<HTMLButtonElement>('.gw-bar button[data-copy]').forEach((b) =>
    b.addEventListener('click', () => navigator.clipboard.writeText(b.dataset.copy!)),
  );
</script>

<style>
  .gw-bar { border: 1px solid var(--sl-color-gray-5); border-radius: 0.5rem; padding: 0.75rem; margin-block: 1rem; }
  figcaption { display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: baseline; font-size: var(--sl-text-sm); }
  .gw-attrs { display: flex; flex-wrap: wrap; gap: 0.75rem; color: var(--sl-color-gray-2); }
  ol { list-style: none; padding: 0; margin: 0.75rem 0; display: grid; grid-template-columns: repeat(8, minmax(0, 1fr)); gap: 0.4rem; }
  .gw-slot { position: relative; display: flex; flex-direction: column; align-items: center; gap: 0.25rem; text-align: center; font-size: var(--sl-text-xs); line-height: 1.2; }
  .gw-slot img, .gw-icon-ph { width: 56px; height: 56px; border-radius: 4px; border: 2px solid transparent; }
  .gw-icon-ph { display: grid; place-items: center; background: var(--sl-color-gray-5); color: var(--sl-color-gray-2); font-weight: 700; }
  .gw-empty .gw-icon-ph { background: transparent; border: 2px dashed var(--sl-color-gray-4); }
  .gw-swap :is(img, .gw-icon-ph) { border-color: var(--sl-color-orange); }
  .gw-filled :is(img, .gw-icon-ph) { border-color: var(--sl-color-green); }
  .gw-name em { color: var(--sl-color-gray-3); }
  .gw-tip { display: none; position: absolute; z-index: 10; top: 100%; left: 50%; transform: translateX(-50%); width: 18rem; padding: 0.6rem; text-align: start; font-size: var(--sl-text-xs); background: var(--sl-color-black); border: 1px solid var(--sl-color-gray-4); border-radius: 0.4rem; }
  .gw-slot:hover .gw-tip, .gw-slot:focus .gw-tip { display: block; }
  .gw-stats { display: flex; gap: 0.6rem; margin-block: 0.3rem; color: var(--sl-color-gray-3); }
  .gw-tip :global(.gw-gray) { color: var(--sl-color-gray-3); }
  .gw-code { display: flex; gap: 0.5rem; align-items: center; font-size: var(--sl-text-xs); }
  .gw-code button { cursor: pointer; font-size: inherit; }
  @media (max-width: 40rem) { ol { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
</style>
