---
/**
 * One weapon set as a card styled like the in-game item tooltip: gold name, the base item's
 * damage line, the mods' effect lines in blue, conditions in gray. Hover or focus opens the mod
 * breakdown (icon, name, lines per mod). Stats come from game data; a Gear `name` written as
 * "Bâton (20 % enchantements, …)" shows its parenthesis as a gray summary under the item name,
 * which covers what the data can't express (inherent stats, unspecified bases).
 *
 *   <div class="gw-weaponcards"><WeaponSetCard set="weapons/vos-scythe" /></div>
 */
import { gearItem, gearName, gearSet, gearStats, gearWiki, tr } from '../../lib/kb';
import { iconFor, iconForGear } from '../../lib/gw/icons';
import { langFromLocals, t } from '../../lib/ui';
import { GameIcon } from '../ui';

interface Props { set: string }
const lang = langFromLocals(Astro.locals);
const _ = t(lang);
const s = await gearSet(Astro.props.set);
const setName = tr(s.data.name, lang)!.text;
const note = tr(s.data.note, lang);

const items = await Promise.all(
  (s.data.weapons ?? []).map(async (ref) => {
    const g = await gearItem(ref);
    const stats = await gearStats(g, lang);
    const custom = tr(g.data.name, lang)?.text;
    const m = custom?.match(/^(.*?)\s*\((.*)\)\s*$/);
    return {
      title: m ? m[1] : (custom ?? stats.base?.name ?? (await gearName(g, lang))),
      summary: m?.[2],
      icon: iconForGear(g),
      href: await gearWiki(g),
      ...stats,
    };
  }),
);
const single = items.length === 1 ? items[0] : undefined;
const mods = items.flatMap((i) => i.mods);
const showItemName = (i: (typeof items)[number]) => !single || i.title.toLowerCase() !== setName.toLowerCase();
---

<article class="gw-wcard" tabindex={mods.length ? 0 : undefined}>
  <header class="gw-wcard__head">
    {single && <GameIcon src={single.icon} label={single.title} size="sm" decorative />}
    {
      single?.href ? (
        <a class="gw-wcard__name" href={single.href} target="_blank" rel="noopener">{setName}</a>
      ) : (
        <span class="gw-wcard__name">{setName}</span>
      )
    }
    {mods.length > 0 && <span class="gw-wcard__hint" aria-hidden="true">{mods.length} mods ▾</span>}
  </header>

  {
    items.map((i) => (
      <div class="gw-wcard__item">
        {showItemName(i) && (
          <p class="gw-wcard__title">
            {!single && <GameIcon src={i.icon} label={i.title} size="xs" decorative />}
            {i.href && !single ? <a href={i.href} target="_blank" rel="noopener">{i.title}</a> : <span>{i.title}</span>}
          </p>
        )}
        {i.summary && <p class="gw-wcard__summary">{i.summary}</p>}
        {(i.base || i.mods.length > 0) && (
          <ul class="gw-wcard__stats">
            {i.base?.lines.map((l) => (
              <li>{l.text}{l.gray && <span class="gw-wcard__gray"> {l.gray}</span>}</li>
            ))}
            {i.mods.flatMap((mod) => mod.lines).map((l) => (
              <li class="gw-wcard__mod-line">{l.text}{l.gray && <span class="gw-wcard__gray"> {l.gray}</span>}</li>
            ))}
          </ul>
        )}
      </div>
    ))
  }

  {note && <p class="gw-wcard__note">{note.text}{note.untranslated && <em> ({_('notTranslated')})</em>}</p>}

  {
    mods.length > 0 && (
      <div class="gw-wcard__pop" role="tooltip">
        <p class="gw-wcard__pop-title">{_('upgrades')}</p>
        <ul class="gw-wcard__mods">
          {mods.map((mod) => (
            <li>
              <GameIcon src={iconFor('mod', mod.id)} label={mod.name} size="sm" decorative />
              <div>
                <strong>{mod.name}</strong>
                {mod.lines.map((l) => (
                  <span class="gw-wcard__mod-line">{l.text}{l.gray && <span class="gw-wcard__gray"> {l.gray}</span>}</span>
                ))}
              </div>
            </li>
          ))}
        </ul>
      </div>
    )
  }
</article>

<style>
  .gw-wcard {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--gw-space-2);
    padding: var(--gw-space-3);
    border: 1px solid var(--gw-tooltip-border);
    border-radius: var(--gw-radius-md);
    background: var(--gw-tooltip-bg);
    color: var(--gw-tooltip-fg);
    font-size: var(--gw-text-sm);
    line-height: 1.45;
    transition: border-color var(--gw-duration-fast) var(--gw-ease);
  }
  .gw-wcard[tabindex] { cursor: help; }
  .gw-wcard:hover,
  .gw-wcard:focus-within { border-color: var(--gw-border-accent); z-index: 10; }
  .gw-wcard:focus-visible { outline: none; box-shadow: var(--gw-focus-ring); }
  .gw-wcard p, .gw-wcard ul { margin: 0; }

  .gw-wcard__head { display: flex; align-items: center; gap: var(--gw-space-2); }
  .gw-wcard__name {
    flex: 1;
    font-family: var(--gw-font-display);
    font-weight: var(--gw-weight-bold);
    color: var(--gw-item-name);
    text-decoration: none;
  }
  a.gw-wcard__name:hover { text-decoration: underline; }
  .gw-wcard__hint { font-size: var(--gw-text-3xs); color: var(--gw-tooltip-muted); white-space: nowrap; }

  .gw-wcard__item { display: grid; gap: var(--gw-space-1); }
  .gw-wcard__item + .gw-wcard__item { padding-top: var(--gw-space-2); border-top: 1px solid var(--gw-tooltip-border); }
  .gw-wcard__title { display: flex; align-items: center; gap: var(--gw-space-2); font-weight: var(--gw-weight-semibold); }
  .gw-wcard__title a { color: inherit; text-decoration: none; }
  .gw-wcard__title a:hover { text-decoration: underline; }
  .gw-wcard__summary { font-size: var(--gw-text-xs); color: var(--gw-tooltip-muted); }

  .gw-wcard__stats { list-style: none; padding: 0; display: grid; }
  .gw-wcard__stats li { margin: 0; }
  .gw-wcard__mod-line { color: var(--gw-item-mod); }
  .gw-wcard__gray { color: var(--gw-tooltip-muted); }

  .gw-wcard__note {
    padding-top: var(--gw-space-2);
    border-top: 1px solid var(--gw-tooltip-border);
    font-size: var(--gw-text-xs);
    font-style: italic;
    color: var(--gw-tooltip-muted);
  }

  .gw-wcard__pop {
    position: absolute;
    top: calc(100% + var(--gw-space-1));
    left: -1px;
    right: -1px;
    min-width: 16rem;
    padding: var(--gw-space-3);
    border: 1px solid var(--gw-border-accent);
    border-radius: var(--gw-radius-md);
    background: var(--gw-tooltip-bg);
    box-shadow: var(--gw-shadow-pop);
    font-size: var(--gw-text-xs);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(4px);
    transition: opacity var(--gw-duration-fast) var(--gw-ease), transform var(--gw-duration-fast) var(--gw-ease), visibility var(--gw-duration-fast);
  }
  .gw-wcard:hover .gw-wcard__pop,
  .gw-wcard:focus-within .gw-wcard__pop { opacity: 1; visibility: visible; transform: none; }
  .gw-wcard .gw-wcard__pop-title {
    margin-bottom: var(--gw-space-2);
    font-family: var(--gw-font-display);
    font-weight: var(--gw-weight-bold);
    font-size: var(--gw-text-3xs);
    letter-spacing: var(--gw-tracking-wider);
    text-transform: uppercase;
    color: var(--gw-tooltip-muted);
  }
  .gw-wcard__mods { list-style: none; padding: 0; display: grid; gap: var(--gw-space-2); }
  .gw-wcard__mods li { margin: 0; display: flex; align-items: flex-start; gap: var(--gw-space-2); }
  .gw-wcard__mods div { display: grid; }
  .gw-wcard__mods strong { color: var(--gw-tooltip-fg); font-weight: var(--gw-weight-semibold); }
</style>
