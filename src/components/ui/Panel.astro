---
/**
 * Panel — the base surface: flat card, hairline border, ornamental corner brackets (.gw-frame).
 * Optional header with a kicker and a title; `actions` slot sits at the header's end.
 *
 *   <Panel kicker="Build" title="VoS IAU"> … <a slot="actions">…</a></Panel>
 */
import type { HTMLTag } from 'astro/types';
import type { Tone } from './types';

interface Props {
  title?: string;
  kicker?: string;
  /** Heading level for the title (keeps the outline right when panels nest). */
  level?: 2 | 3 | 4;
  as?: HTMLTag;
  tone?: Extract<Tone, 'neutral' | 'accent' | 'info'>;
  padding?: 'none' | 'sm' | 'md';
  class?: string;
}
const { title, kicker, level = 2, as: Tag = 'section', tone = 'neutral', padding = 'md', class: cls } = Astro.props;
const H = `h${level}` as HTMLTag;
const hasHeader = title || kicker || Astro.slots.has('actions');
---

<Tag class:list={['gw-panel', 'gw-frame', tone === 'accent' && 'gw-frame--accent', `gw-panel--${tone}`, `gw-panel--pad-${padding}`, cls]}>
  {
    hasHeader && (
      <header class="gw-panel__head">
        <div>
          {kicker && <p class="gw-panel__kicker">{kicker}</p>}
          {title && <H class="gw-panel__title">{title}</H>}
        </div>
        {Astro.slots.has('actions') && <div class="gw-panel__actions"><slot name="actions" /></div>}
      </header>
    )
  }
  <slot />
</Tag>

<style>
  .gw-panel {
    position: relative;
    border: 1px solid var(--gw-border);
    border-radius: var(--gw-radius-lg);
    background: var(--gw-surface-1);
    box-shadow: var(--gw-shadow-card);
  }
  .gw-panel--accent { border-color: var(--gw-border-accent); }
  .gw-panel--info { border-color: var(--gw-tone-info-border); }
  .gw-panel--pad-sm { padding: var(--gw-space-4) var(--gw-space-5); }
  .gw-panel--pad-md { padding: var(--gw-space-5); }
  .gw-panel--pad-none { padding: 0; overflow: hidden; }

  .gw-panel__head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--gw-space-4);
    margin-bottom: var(--gw-space-4);
  }
  .gw-panel--pad-none > .gw-panel__head { padding: var(--gw-space-4) var(--gw-space-5) 0; }
  .gw-panel__kicker {
    margin: 0 0 var(--gw-space-1);
    font-family: var(--gw-font-display);
    font-weight: var(--gw-weight-bold);
    font-size: var(--gw-text-3xs);
    letter-spacing: var(--gw-tracking-widest);
    text-transform: uppercase;
    color: var(--gw-accent);
  }
  .gw-panel--info .gw-panel__kicker { color: var(--gw-tone-info-fg); }
  .gw-panel__title {
    margin: 0;
    font-family: var(--gw-font-display);
    font-weight: var(--gw-weight-bold);
    font-size: var(--gw-text-lg);
    line-height: 1.2;
    letter-spacing: var(--gw-tracking-wide);
    color: var(--gw-text-strong);
  }
  .gw-panel__actions { display: flex; gap: var(--gw-space-2); align-items: center; font-size: var(--gw-text-sm); }
</style>
