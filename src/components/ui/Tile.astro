---
/**
 * Tile — compact icon card for grids of items (Gear, Consumables), market-style.
 * Lay several out with the `.gw-tiles` grid class (global, base.css).
 *
 *   <Tile href="/gear/runes/…/" title="Rune of Superior Vigor" meta="Rune" icon={img} />
 */
import type { ImageMetadata } from 'astro';
import GameIcon from './GameIcon.astro';

interface Props {
  href: string;
  title: string;
  meta?: string;
  icon?: ImageMetadata;
  class?: string;
}
const { href, title, meta, icon, class: cls } = Astro.props;
---

<a class:list={['gw-tile', cls]} href={href}>
  <GameIcon src={icon} label={title} size="lg" decorative />
  <span class="gw-tile__title">{title}</span>
  {meta && <span class="gw-tile__meta">{meta}</span>}
  {Astro.slots.has('default') && <span class="gw-tile__extra"><slot /></span>}
</a>

<style>
  .gw-tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gw-space-2);
    height: 100%;
    padding: var(--gw-space-4) var(--gw-space-3);
    border: 1px solid var(--gw-border);
    border-radius: var(--gw-radius-md);
    background: var(--gw-surface-1);
    color: var(--gw-text);
    text-align: center;
    text-decoration: none;
    transition: border-color var(--gw-duration-fast) var(--gw-ease), background-color var(--gw-duration-fast) var(--gw-ease), transform var(--gw-duration-base) var(--gw-ease);
  }
  .gw-tile:hover {
    border-color: var(--gw-border-accent);
    background: var(--gw-surface-hover);
    transform: translateY(-2px);
  }
  .gw-tile__title { font-weight: var(--gw-weight-bold); font-size: var(--gw-text-xs); line-height: 1.3; color: var(--gw-text-strong); }
  .gw-tile__meta {
    font-family: var(--gw-font-display);
    font-weight: var(--gw-weight-bold);
    font-size: var(--gw-text-3xs);
    letter-spacing: var(--gw-tracking-wider);
    text-transform: uppercase;
    color: var(--gw-text-subtle);
  }
  .gw-tile__extra { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--gw-space-1); margin-top: auto; }
</style>
