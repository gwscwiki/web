---
/**
 * Living style guide: every token and ui/ primitive, plus the domain blocks built from them.
 * Not in the sidebar or search. Check it after touching src/styles or src/components/ui
 * (in both themes). See docs/design-system.md.
 */
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Button, Divider, GameIcon, Kicker, List, Panel, PathCard, Select, Stat, Tag, Tile, Tooltip, type Tone } from '../components/ui';
import SkillBar from '../components/blocks/SkillBar.astro';
import BuildBar from '../components/blocks/BuildBar.astro';
import GearCard from '../components/blocks/GearCard.astro';
import DutyBadge from '../components/blocks/DutyBadge.astro';
import RequirementLevel from '../components/entity/RequirementLevel.astro';

const groups: Record<string, string[]> = {
  Surfaces: ['bg', 'bg-deep', 'surface-1', 'surface-2', 'surface-3', 'surface-inset', 'surface-hover'],
  Text: ['text-strong', 'text', 'text-muted', 'text-subtle', 'accent-text'],
  Accent: ['accent', 'accent-strong', 'accent-soft', 'accent-fill', 'accent-fill-hover'],
  Pairings: ['tone-success-fg', 'tone-info-fg', 'tone-danger-fg', 'tone-warning-fg', 'tone-success-bg', 'tone-info-bg', 'tone-danger-bg', 'tone-warning-bg'],
  Lines: ['border', 'border-strong', 'border-accent', 'divider', 'ornament', 'ornament-accent'],
  Game: ['elite', 'energy', 'adrenaline', 'health'],
};
const tones: Tone[] = ['neutral', 'accent', 'info', 'success', 'warning', 'danger'];
const type = [
  ['4xl', 'display'], ['3xl', 'display'], ['2xl', 'display'], ['xl', 'display'], ['lg', 'body'], ['md', 'body'], ['sm', 'body'], ['xs', 'body'], ['2xs', 'body'],
];
const VOS_CORE = 'OgCjkirMrSmXfbaXNX3lcXsX5iA';
---

<StarlightPage frontmatter={{ title: 'Design system', description: 'Tokens and components of the GW Speedclear UI.', pagefind: false, tableOfContents: { minHeadingLevel: 2, maxHeadingLevel: 2 } }} headings={[
  { depth: 2, slug: 'tokens', text: 'Tokens' },
  { depth: 2, slug: 'type', text: 'Type' },
  { depth: 2, slug: 'primitives', text: 'Primitives' },
  { depth: 2, slug: 'domain', text: 'Domain blocks' },
]}>
  <div class="ds not-content">
    <p class="gw-muted">Source of truth: <code>src/styles/</code> (tokens → theme → base) and <code>src/components/ui/</code>. Rules in <code>docs/design-system.md</code>. Toggle the theme in the header to check both.</p>

    <h2 id="tokens">Tokens</h2>
    {
      Object.entries(groups).map(([name, tokens]) => (
        <Panel title={name} level={3} padding="sm">
          <div class="ds-swatches">
            {tokens.map((tk) => (
              <figure class="ds-swatch">
                <span style={`background: var(--gw-${tk})`} />
                <figcaption><code>--gw-{tk}</code></figcaption>
              </figure>
            ))}
          </div>
        </Panel>
      ))
    }
    <Panel title="Tones" level={3} padding="sm">
      <div class="ds-row">{tones.map((t) => <Tag tone={t}>{t}</Tag>)}</div>
    </Panel>

    <h2 id="type">Type</h2>
    <Panel padding="sm">
      {type.map(([size, face]) => (
        <p class:list={['ds-type', face === 'display' && 'ds-type--display']} style={`font-size: var(--gw-text-${size})`}>
          <code>--gw-text-{size}</code> {face === 'display' ? 'Fissure of Woe' : 'Voeu de force — Vow of Strength'}
        </p>
      ))}
      <Kicker>Kicker · tracking widest</Kicker>
    </Panel>

    <h2 id="primitives">Primitives</h2>

    <Panel kicker="ui/Panel" title="Panel" level={3}>
      <a slot="actions" href="#primitives">Action →</a>
      <div class="ds-grid">
        <Panel title="neutral" level={4} padding="sm">Default surface.</Panel>
        <Panel title="accent" tone="accent" level={4} padding="sm">Highlighted surface.</Panel>
        <Panel title="info" tone="info" level={4} padding="sm">Secondary highlight.</Panel>
      </div>
    </Panel>

    <Panel kicker="ui/Divider + ornaments.css" title="Ornaments" level={3}>
      <Divider />
      <Divider tone="accent" />
      <p class="gw-muted">Every Panel and PathCard carries <code>.gw-frame</code> corner brackets; <code>tone="accent"</code> turns them teal. Markdown h2 headings get a diamond.</p>
    </Panel>

    <Panel kicker="ui/Button" title="Button" level={3}>
      <div class="ds-row">
        <Button>Primary</Button>
        <Button variant="secondary">Secondary</Button>
        <Button variant="ghost">Ghost</Button>
        <Button size="sm" variant="ghost">Small</Button>
        <Button size="lg" arrow>Large + arrow</Button>
      </div>
    </Panel>

    <Panel kicker="ui/Tag" title="Tag" level={3}>
      <div class="ds-row">
        {tones.map((t) => <Tag tone={t} size="sm">{t} sm</Tag>)}
        <Tag href="#primitives" tone="accent">link</Tag>
      </div>
    </Panel>

    <Panel kicker="ui/GameIcon" title="GameIcon" level={3}>
      <div class="ds-row">
        <GameIcon label="Vow of Strength" size="xs" />
        <GameIcon label="Vow of Strength" size="sm" />
        <GameIcon label="Vow of Strength" size="md" />
        <GameIcon label="Vow of Strength" size="lg" />
        <GameIcon label="Vow of Strength" size="lg" elite />
        {tones.slice(1).map((t) => <GameIcon label={`Ring ${t}`} size="lg" ring={t} />)}
        <GameIcon label="" size="lg" empty />
      </div>
      <p class="gw-muted">Placeholders shown; real icons come from <code>iconFor()</code> (src/lib/gw/icons.ts).</p>
    </Panel>

    <Panel kicker="ui/Tooltip + ui/Stat" title="Tooltip & Stat" level={3}>
      <div class="ds-row">
        <Tooltip>
          <GameIcon label="Vow of Strength" size="lg" elite decorative />
          <Fragment slot="tip">
            <strong>Vow of Strength</strong><br />
            <Stat kind="energy" value={5} label="Energy" /> <Stat kind="activation" value="¼" label="Activation" /> <Stat kind="recharge" value={20} label="Recharge" />
          </Fragment>
        </Tooltip>
        <Stat kind="energy" value={5} label="Energy" />
        <Stat kind="adrenaline" value={6} label="Adrenaline" />
        <Stat kind="activation" value={1} label="Activation" />
        <Stat kind="recharge" value={20} label="Recharge" />
        <Stat kind="upkeep" value={-1} label="Upkeep" />
        <Stat kind="sacrifice" value="10%" label="Sacrifice" />
      </div>
    </Panel>

    <Panel kicker="ui/List" title="List" level={3}>
      <div class="ds-grid">
        <List><li>Diamond marker</li><li>Hairline separators</li><li>Last item has no border</li></List>
        <List ordered><li>ToC</li><li>Griffs</li><li>Forge</li></List>
      </div>
    </Panel>

    <Panel kicker="ui/Select" title="Select" level={3}>
      <div class="ds-row">
        <Select label="Zone" name="ds-zone"><option>Tous</option><option>FoW</option></Select>
        <Select label="Niveau" name="ds-level"><option>Tous</option><option>Requis</option></Select>
      </div>
    </Panel>

    <Panel kicker="ui/Tile" title="Tile" level={3}>
      <ul class="gw-tiles">
        <li><Tile href="#primitives" title="Rune of Superior Vigor" meta="Runes"><Tag tone="warning" size="sm">Recommandé</Tag></Tile></li>
        <li><Tile href="#primitives" title="Windwalker Insignia" meta="Insignias" /></li>
        <li><Tile href="#primitives" title="Grail of Might" meta="Cons" /></li>
      </ul>
    </Panel>

    <div class="gw-paths">
      <PathCard tag="ui/PathCard" title="Path" kicker="Accent tone" href="#primitives" cta="Call to action"><ul><li>List item</li><li>List item</li></ul></PathCard>
      <PathCard tag="ui/PathCard" title="Path" kicker="Info tone" href="#primitives" cta="Call to action" tone="info"><p>Paragraph body.</p></PathCard>
    </div>

    <h2 id="domain">Domain blocks</h2>
    <Panel kicker="blocks/SkillBar" title="SkillBar (raw code)" level={3}><SkillBar code={VOS_CORE} /></Panel>
    <Panel kicker="blocks/BuildBar" title="BuildBar (swap marked)" level={3}><BuildBar build="builds/vos/iau" /></Panel>
    <Panel kicker="blocks/GearCard · DutyBadge · entity/RequirementLevel" title="Inline blocks" level={3}>
      <div class="ds-row">
        <GearCard gear="runes/rune-of-superior-vigor" />
        <DutyBadge duty="fow/duties/griffs" />
        <RequirementLevel level="required" />
        <RequirementLevel level="recommended" />
        <RequirementLevel level="optional" />
      </div>
    </Panel>
  </div>
</StarlightPage>

<style>
  .ds { display: grid; gap: var(--gw-space-4); }
  .ds h2 {
    margin: var(--gw-space-5) 0 0;
    font-family: var(--gw-font-display);
    font-weight: var(--gw-weight-bold);
    font-size: var(--gw-text-xl);
    letter-spacing: var(--gw-tracking-wide);
    text-transform: uppercase;
    color: var(--gw-text-strong);
  }
  .ds-row { display: flex; flex-wrap: wrap; align-items: center; gap: var(--gw-space-3); }
  .ds-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); gap: var(--gw-space-3); }
  .ds-swatches { display: grid; grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr)); gap: var(--gw-space-3); }
  .ds-swatch { margin: 0; display: grid; gap: var(--gw-space-1); }
  .ds-swatch span { height: 2.5rem; border-radius: var(--gw-radius-sm); border: 1px solid var(--gw-border); }
  .ds-swatch code { font-size: var(--gw-text-3xs); color: var(--gw-text-muted); }
  .ds-type { margin: 0 0 var(--gw-space-2); color: var(--gw-text-strong); line-height: 1.3; }
  .ds-type code { font-family: var(--gw-font-mono); font-size: var(--gw-text-3xs); font-weight: var(--gw-weight-regular); letter-spacing: 0; text-transform: none; color: var(--gw-text-subtle); margin-inline-end: var(--gw-space-2); }
  .ds-type--display { font-family: var(--gw-font-display); font-weight: var(--gw-weight-bold); letter-spacing: var(--gw-tracking-wide); text-transform: uppercase; }
</style>
